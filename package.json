{
  "name": "journeys-by-nutweir",
  "private": true,
  "version": "2.0.0",
  "description": "Personal travel journal: Vue 3 public site + CMS on Supabase",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build && tsx --tsconfig tsconfig.node.json scripts/prerender.ts",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:db": "tsx scripts/test-db.ts",
    "test:e2e": "playwright test",
    "migrate:legacy": "tsx scripts/migrate-legacy.ts",
    "verify:migration": "tsx scripts/verify-migration.ts",
    "seed:supabase": "tsx --tsconfig tsconfig.node.json scripts/seed-supabase.ts",
    "export:trip": "tsx --tsconfig tsconfig.node.json scripts/export-trip.ts",
    "backup": "tsx --tsconfig tsconfig.node.json scripts/backup.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@tiptap/extension-link": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "@tiptap/vue-3": "^2.27.3",
    "dompurify": "^3.4.16",
    "idb": "^8.0.4",
    "pinia": "^3.0.4",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "jsdom": "^26.1.0",
    "pg": "^8.23.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.8",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.3.12"
  }
}
