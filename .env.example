# Copy to .env.local (never commit real values).

# Base path: /huainamyen/ on GitHub Pages, / on a custom domain.
VITE_BASE=/huainamyen/
# Public site URL, used for canonical links and social cards at build time.
VITE_SITE_URL=https://nutweir.github.io/huainamyen

# "local" = no backend: content in this browser's IndexedDB, seeded from the migrated
#           Huai Nam Yen journal. Admin login is a local test login (dev only).
# "supabase" = real backend (needs the two values below).
VITE_BACKEND=local

# Supabase project → Settings → API. The anon key is public by design (RLS protects data).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server-side only: scripts/seed-supabase.ts. NEVER prefix with VITE_, never ship to the browser. ---
SUPABASE_SERVICE_ROLE_KEY=
